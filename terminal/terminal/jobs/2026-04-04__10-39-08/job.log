Sending keys: ['cat > /app/services/api/app.py << \'EOF\'\nfrom flask import Flask, jsonify, request\nfrom sqlalchemy import create_engine, text\nimport redis\nimport os\nimport json\nimport time\n\napp = Flask(__name__)\n\n# Fixed Bug 1: correct env var\nengine = create_engine(os.environ.get("DATABASE_URL", "sqlite:////tmp/taskdb.sqlite"))\nredis_client = redis.from_url(os.environ.get("REDIS_URL", "redis://localhost:6379"))\n\ndef init_db():\n    with engine.connect() as conn:\n        conn.execute(text("""\n            CREATE TABLE IF NOT EXISTS jobs (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                payload TEXT NOT NULL,\n                status TEXT DEFAULT \'pending\',\n                priority INTEGER DEFAULT 0,\n                created_at TEXT DEFAULT (datetime(\'now\')),\n                processed_at TEXT\n            )\n        """))\n        conn.commit()\n\n@app.route("/health")\ndef health():\n    try:\n        with engine.connect() as conn:\n            conn.execute(text("SELECT 1"))\n        redis_client.ping()\n        return jsonify({"status": "healthy", "db": "ok", "redis": "ok"})\n    except Exception as e:\n        return jsonify({"status": "unhealthy", "error": str(e)}), 500\n\n@app.route("/jobs", methods=["POST"])\ndef create_job():\n    data = request.get_json()\n    if not data or "payload" not in data:\n        return jsonify({"error": "payload required"}), 400\n    priority = data.get("priority", 0)\n    if not isinstance(priority, int):\n        return jsonify({"error": "priority must be integer"}), 400\n    with engine.connect() as conn:\n        result = conn.execute(\n            text("INSERT INTO jobs (payload, priority) VALUES (:payload, :priority)"),\n            {"payload": data["payload"], "priority": priority}\n        )\n        conn.commit()\n        job_id = result.lastrowid\n    # Fixed Bug 2: correct queue name\n    redis_client.lpush("job_queue", json.dumps({"id": job_id, "payload": data["payload"], "priority": priority}))\n    return jsonify({"id": job_id, "status": "pending"}), 201\n\n@app.route("/jobs/<int:job_id>")\ndef get_job(job_id):\n    with engine.connect() as conn:\n        result = conn.execute(\n            text("SELECT id, payload, status, priority, created_at FROM jobs WHERE id = :id"),\n            {"id": job_id}\n        )\n        row = result.fetchone()\n    if not row:\n        return jsonify({"error": "not found"}), 404\n    return jsonify({"id": row[0], "payload": row[1], "status": row[2], "priority": row[3], "created_at": str(row[4])})\n\n@app.route("/jobs")\ndef list_jobs():\n    status = request.args.get("status")\n    with engine.connect() as conn:\n        if status:\n            # Fixed Bug 3: correct sorting order for high priority first\n            result = conn.execute(\n                text("SELECT id, payload, status, priority FROM jobs WHERE status = :status ORDER BY priority DESC"),\n                {"status": status}\n            )\n        else:\n            result = conn.execute(text("SELECT id, payload, status, priority FROM jobs ORDER BY created_at DESC"))\n        rows = result.fetchall()\n    return jsonify([{"id": r[0], "payload": r[1], "status": r[2], "priority": r[3]} for r in rows])\n\n@app.route("/stats")\ndef stats():\n    with engine.connect() as conn:\n        result = conn.execute(text("SELECT status, COUNT(*) FROM jobs GROUP BY status"))\n        rows = result.fetchall()\n    return jsonify({row[0]: row[1] for row in rows})\n\nif __name__ == "__main__":\n    init_db()\n    app.run(host="0.0.0.0", port=8000, debug=False)\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
